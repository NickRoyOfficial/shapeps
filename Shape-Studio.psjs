// Shape Studio for Photoshop 26.7. Run from File > Scripts > Browse.
const { app, action, constants, imaging } = require("photoshop");
const { script } = require("uxp");
const shapes = ["Organic blob", "Circle", "Oval", "Square", "Rectangle",
  "Triangle", "Diamond", "Pentagon", "Hexagon", "Star"];

const enumeration = (type, value) => ({ _enum: type, _value: value });
const unit = (name, value) => ({ _unit: name, _value: value });
const layerRef = id => ({ _ref: "layer", _id: id });

function outline(shape, seed) {
  const count = [16, 16, 16, 4, 4, 3, 4, 5, 6, 10][shape];
  const smooth = shape < 3;
  const diagonal = shape === 3 || shape === 4;
  const start = diagonal ? -Math.PI / 4 : -Math.PI / 2;
  const phase = [2, 3, 5].map(n => {
    const x = Math.sin((seed + n * 137) * 12.9898) * 43758.5453;
    return 2 * Math.PI * (x - Math.floor(x));
  });
  const points = Array.from({ length: count }, (_, i) => {
    const angle = start + i * 2 * Math.PI / count;
    let radius = shape === 9 && i % 2 ? 0.46 : 1;
    if (shape === 0) {
      radius += 0.20 * Math.sin(2 * angle + phase[0])
        + 0.16 * Math.sin(3 * angle + phase[1])
        + 0.06 * Math.sin(5 * angle + phase[2]);
    }
    const aspect = shape === 2 || shape === 4 ? 0.63 : 1;
    return [radius * Math.cos(angle), aspect * radius * Math.sin(angle)];
  });
  return points.map(([x, y], i) => {
    const prev = points[(i + count - 1) % count];
    const next = points[(i + 1) % count];
    const dx = smooth ? (next[0] - prev[0]) / 6 : 0;
    const dy = smooth ? (next[1] - prev[1]) / 6 : 0;
    return { anchor: [x, y], incoming: [x - dx, y - dy], outgoing: [x + dx, y + dy], smooth };
  });
}

function fittedOutline(points, width, height, size) {
  const all = points.flatMap(p => [p.anchor, p.incoming, p.outgoing]);
  const x = all.map(p => p[0]), y = all.map(p => p[1]);
  const left = Math.min(...x), right = Math.max(...x);
  const top = Math.min(...y), bottom = Math.max(...y);
  const spanX = right - left, spanY = bottom - top;
  const scale = Math.min(width / spanX, height / spanY) * size / 100;
  return {
    points, scale, spanX: spanX * scale, spanY: spanY * scale,
    x: (width - (left + right) * scale) / 2,
    y: (height - (top + bottom) * scale) / 2
  };
}

function subpath(geometry, ratio = 1, subtract = false) {
  const { points, scale, x, y } = geometry;
  const position = ([px, py]) => [x + px * ratio * scale, y + py * ratio * scale];
  const path = new app.SubPathInfo();
  path.closed = true;
  path.operation = subtract ? constants.ShapeOperation.SHAPESUBTRACT
    : constants.ShapeOperation.SHAPEADD;
  path.entireSubPath = points.map(p => {
    const point = new app.PathPointInfo();
    point.kind = p.smooth ? constants.PointKind.SMOOTHPOINT : constants.PointKind.CORNERPOINT;
    point.anchor = position(p.anchor);
    // Photoshop's leftDirection leaves this knot. rightDirection enters it.
    point.leftDirection = position(p.outgoing);
    point.rightDirection = position(p.incoming);
    return point;
  });
  return path;
}

function contourIntervals(count) {
  const step = 0.81 / (count + 1);
  return Array.from({ length: count }, (_, i) => {
    const outer = 1 - (i + 1) * step;
    return [outer, outer - step * 0.18];
  });
}

function bands(geometry, count) {
  return contourIntervals(count).flatMap(([outer, inner]) => [
    subpath(geometry, outer), subpath(geometry, inner, true)
  ]);
}

function rgb(hex) {
  return hex.match(/../g).map(pair => parseInt(pair, 16));
}

function color(hex) {
  const [red, grain, blue] = rgb(hex);
  return { _obj: "RGBColor", red, grain, blue };
}

function fillOptions(settings, geometry, doc) {
  if (settings.fill === 0) return { _obj: "solidColorLayer", color: color(settings.first) };
  const radians = settings.angle * Math.PI / 180;
  const projected = (w, h) => Math.abs(Math.cos(radians)) * w + Math.abs(Math.sin(radians)) * h;
  const scale = 100 * projected(geometry.spanX, geometry.spanY) / projected(doc.width, doc.height);
  const stops = [0, 4096];
  return {
    _obj: "gradientLayer",
    type: enumeration("gradientType", "linear"),
    angle: unit("angleUnit", settings.angle),
    scale: unit("percentUnit", Math.max(1, Math.round(scale))),
    align: false,
    dither: true,
    gradient: {
      _obj: "gradientClassEvent",
      name: "Shape Studio gradient",
      gradientForm: enumeration("gradientForm", "customStops"),
      interfaceIconFrameDimmed: 4096,
      colors: [settings.first, settings.second].map((hex, i) => ({
        _obj: "colorStop", color: color(hex), location: stops[i], midpoint: 50,
        type: enumeration("colorStopType", "userStop")
      })),
      transparency: stops.map(location => ({ _obj: "transferSpec", location,
        midpoint: 50, opacity: unit("percentUnit", 100) }))
    }
  };
}

async function play(descriptor) {
  const [result] = await action.batchPlay([{ ...descriptor,
    _options: { dialogOptions: "dontDisplay" } }], {});
  if (result?._obj === "error") throw new Error(result.message || descriptor._obj);
  return result;
}

async function makeShape(doc, name, paths, fill) {
  const previousLayerId = doc.activeLayers[0]?.id;
  await play({
    _obj: "make",
    _target: [{ _ref: "contentLayer" }],
    using: { _obj: "contentLayer", type: fill }
  });
  const layer = doc.activeLayers[0];
  if (!layer || layer.id === previousLayerId) throw new Error("Photoshop did not create a fill layer.");

  const hasVectorMask = await play({
    _obj: "get", _target: [{ _ref: "property", _property: "hasVectorMask" }, layerRef(layer.id)]
  });
  if (hasVectorMask?.hasVectorMask) {
    await play({
      _obj: "delete", _target: [{ _ref: "path", ...enumeration("path", "vectorMask") }, layerRef(layer.id)]
    });
  }
  const pathName = `Shape Studio temporary ${layer.id}-${Date.now()}`;
  // Address the saved path by name because the result of add() can lack PathItem methods.
  await doc.pathItems.add(pathName, paths);
  const pathRef = { _ref: "path", _name: pathName };
  await play({ _obj: "select", _target: [pathRef] });
  await play({
    _obj: "make",
    _target: [{ _ref: "path" }, layerRef(layer.id)],
    at: { _ref: "path", ...enumeration("path", "vectorMask") },
    using: { _ref: "path", ...enumeration("ordinal", "targetEnum") }
  });
  await play({ _obj: "delete", _target: [pathRef] });
  layer.name = name;
  return layer;
}

async function selectLayer(id, add = false) {
  const descriptor = { _obj: "select", _target: [layerRef(id)], makeVisible: false };
  if (add) descriptor.selectionModifier = enumeration("selectionModifierType", "addToSelection");
  await play(descriptor);
}

async function generate(doc, settings) {
  const history = script.executionContext.hostControl;
  const suspension = await history.suspendHistory({ documentID: doc.id, name: "Generate Shape Studio shape" });
  try {
    let selectionChannel;
    if (doc.selection.bounds) {
      const channelName = "Shape Studio selection " + Date.now();
      await doc.selection.save(channelName);
      selectionChannel = doc.channels.getByName(channelName);
      await doc.selection.deselect();
    }

    const geometry = fittedOutline(outline(settings.shape, settings.seed), doc.width, doc.height, settings.size);
    const name = shapes[settings.shape];
    let base = await makeShape(doc, name, [subpath(geometry)], fillOptions(settings, geometry, doc));
    const topo = settings.count > 0 ? await makeShape(doc, "Topo lines", bands(geometry, settings.count),
      { _obj: "solidColorLayer", color: color(settings.line) }) : null;

    if (settings.output === 1) {
      await base.rasterize(constants.RasterizeType.ENTIRELAYER);
      if (topo) {
        await topo.rasterize(constants.RasterizeType.ENTIRELAYER);
        await selectLayer(base.id);
        await selectLayer(topo.id, true);
        const selected = Array.from(doc.activeLayers, layer => layer.id);
        if (selected.length !== 2 || !selected.includes(base.id) || !selected.includes(topo.id)) {
          throw new Error("Photoshop could not select the two generated layers for merging.");
        }
        base = await topo.merge();
      }
      base.name = name + " - Raster";
      await selectLayer(base.id);
    } else if (topo) {
      await doc.createLayerGroup({ name, fromLayers: [topo, base] });
    } else {
      await selectLayer(base.id);
    }

    if (selectionChannel) {
      await doc.selection.load(selectionChannel);
      selectionChannel.remove();
    }
  } catch (error) {
    await history.resumeHistory(suspension, false);
    throw error;
  }
  await history.resumeHistory(suspension, true);
}

function sampleOutline(points) {
  return points.flatMap((point, i) => {
    if (!point.smooth) return [point.anchor];
    const next = points[(i + 1) % points.length];
    return Array.from({ length: 12 }, (_, step) => {
      const t = step / 12, s = 1 - t;
      return point.anchor.map((start, axis) =>
        s ** 3 * start + 3 * s ** 2 * t * point.outgoing[axis]
        + 3 * s * t ** 2 * next.incoming[axis] + t ** 3 * next.anchor[axis]
      );
    });
  });
}

function paintMask(mask, width, height, polygon, value) {
  const rows = polygon.map(point => point[1]);
  const top = Math.max(0, Math.ceil(Math.min(...rows) - 0.5));
  const bottom = Math.min(height, Math.ceil(Math.max(...rows) - 0.5));
  for (let y = top; y < bottom; y++) {
    const scan = y + 0.5;
    const crossings = [];
    for (let i = 0; i < polygon.length; i++) {
      const [ax, ay] = polygon[i];
      const [bx, by] = polygon[(i + 1) % polygon.length];
      if ((ay > scan) !== (by > scan)) crossings.push(ax + (scan - ay) * (bx - ax) / (by - ay));
    }
    crossings.sort((a, b) => a - b);
    for (let i = 0; i + 1 < crossings.length; i += 2) {
      const left = Math.max(0, Math.ceil(crossings[i] - 0.5));
      const right = Math.min(width, Math.ceil(crossings[i + 1] - 0.5));
      mask.fill(value, y * width + left, y * width + right);
    }
  }
}

const previewWidth = 336;
const previewHeight = 320;

function previewPixels(doc, settings, width, height) {
  const frameScale = Math.min((width - 48) / doc.width, (height - 48) / doc.height);
  const frameWidth = doc.width * frameScale;
  const frameHeight = doc.height * frameScale;
  const left = (width - frameWidth) / 2;
  const top = (height - frameHeight) / 2;
  const geometry = fittedOutline(outline(settings.shape, settings.seed), frameWidth, frameHeight, settings.size);
  const samples = sampleOutline(geometry.points);
  const contour = ratio => samples.map(([x, y]) => [
    left + geometry.x + x * geometry.scale * ratio, top + geometry.y + y * geometry.scale * ratio
  ]);
  const fill = new Uint8Array(width * height);
  const lines = new Uint8Array(width * height);
  paintMask(fill, width, height, contour(1), 1);
  for (const [outer, inner] of contourIntervals(settings.count)) {
    paintMask(lines, width, height, contour(outer), 1);
    paintMask(lines, width, height, contour(inner), 0);
  }

  const pixels = new Uint8Array(width * height * 3);
  const start = rgb(settings.first);
  const end = settings.fill ? rgb(settings.second) : start;
  const line = settings.count ? rgb(settings.line) : start;
  const angle = settings.angle * Math.PI / 180;
  const dx = Math.cos(angle), dy = -Math.sin(angle);
  const gradientSpan = Math.abs(dx) * geometry.spanX + Math.abs(dy) * geometry.spanY;
  const background = [22, 22, 29], artboard = [32, 33, 42], grid = [41, 43, 54];

  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const index = y * width + x;
      const onArtboard = x >= left && x < left + frameWidth && y >= top && y < top + frameHeight;
      const gridLine = Math.floor(x - left) % 38 === 0 || Math.floor(y - top) % 38 === 0;
      const backdrop = onArtboard ? (gridLine ? grid : artboard) : background;
      const position = 0.5 + ((x - width / 2) * dx + (y - height / 2) * dy) / gradientSpan;
      const mix = Math.max(0, Math.min(1, position));
      for (let channel = 0; channel < 3; channel++) {
        pixels[index * 3 + channel] = lines[index] ? line[channel]
          : fill[index] ? Math.round(start[channel] + mix * (end[channel] - start[channel]))
          : backdrop[channel];
      }
    }
  }
  return pixels;
}

async function previewImage(doc, settings) {
  const width = previewWidth * 2, height = previewHeight * 2;
  const imageData = await imaging.createImageDataFromBuffer(previewPixels(doc, settings, width, height), {
    width, height, components: 3, colorSpace: "RGB", colorProfile: "sRGB IEC61966-2.1"
  });
  try {
    const jpeg = await imaging.encodeImageData({ imageData, base64: true });
    return "data:image/jpeg;base64," + jpeg;
  } finally {
    imageData.dispose();
  }
}

const studioStyles = `
  .shape-studio {
    box-sizing: border-box; width: 700px; max-width: 96vw; padding: 0;
    border: 1px solid #3c3c49; border-radius: 14px; background: #21212a; color: #f5f4fa;
    font-family: "Segoe UI", sans-serif; font-size: 13px;
  }
  .shape-studio * { box-sizing: border-box; }
  .shape-header, .shape-footer {
    display: flex; justify-content: space-between; align-items: center; padding: 18px 22px;
  }
  .shape-header { border-bottom: 1px solid #353542; }
  .shape-title { margin: 0; font-size: 27px; font-weight: 700; letter-spacing: -0.6px; }
  .shape-body {
    display: flex; flex-wrap: wrap; align-items: flex-start; padding: 20px 22px;
    overflow-y: auto; max-height: 70vh;
  }
  .shape-left { flex: 1 1 336px; min-width: 260px; margin-right: 20px; }
  .shape-controls { flex: 1 1 258px; min-width: 240px; }
  .shape-inline { display: flex; align-items: center; justify-content: space-between; }
  .shape-eyebrow {
    margin: 0 0 11px; color: #c2bcd5; font-size: 11px; font-weight: 700; letter-spacing: 1.1px;
  }
  .shape-preview-header { margin-bottom: 10px; }
  .shape-preview-header .shape-eyebrow { margin: 0; }
  .shape-preview {
    width: 100%; height: 320px; overflow: hidden; border: 1px solid #393944;
    border-radius: 9px; background: #16161d; position: relative;
  }
  .shape-preview img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .shape-preview-message { position: absolute; top: 144px; width: 100%; text-align: center; color: #c2bcd5; }
  .shape-seed { margin-top: 12px; }
  .shape-seed input { width: 108px; }
  .shape-output { display: flex; align-items: center; }
  .shape-output .shape-caption { margin-right: 10px; }
  .shape-caption { color: #c8c4d5; font-size: 12px; }
  .shape-segments {
    display: flex; padding: 3px; background: #16161d; border: 1px solid #424250; border-radius: 7px;
  }
  .shape-studio button {
    appearance: none; min-height: 30px; padding: 0 11px; border: 1px solid #515163;
    border-radius: 5px; background: #2b2b36; color: #f4f2fb; font-size: 12px; font-weight: 600;
  }
  .shape-segments button { flex: 1; border-color: transparent; background: transparent; }
  .shape-segments button.selected { background: #494263; color: #faf6ff; }
  .shape-studio button:hover { border-color: #bdb0f8; }
  .shape-studio :focus { outline: 2px solid #c2b5ff; outline-offset: 2px; }
  .shape-section + .shape-section { border-top: 1px solid #393944; margin-top: 14px; padding-top: 13px; }
  .shape-studio label { display: block; color: #e4e0ee; font-size: 12px; margin-bottom: 5px; }
  .shape-studio select, .shape-studio input[type="text"] {
    color: #f6f3fa; background: #2b2b36; border: 1px solid #515163;
    border-radius: 5px; padding: 4px 7px; height: 31px;
  }
  .shape-studio select { width: 100%; }
  .shape-studio input[type="text"] { appearance: none; font-family: Consolas, monospace; }
  .shape-studio input[type="range"] { width: 100%; margin: 0; accent-color: #c2b5ff; }
  .shape-range { margin-top: 9px; }
  .shape-range label { margin-bottom: 3px; }
  .shape-value { color: #d9ceff; font-family: Consolas, monospace; font-size: 12px; }
  .shape-colors { display: flex; margin-top: 9px; }
  .shape-color { min-width: 0; flex: 1; }
  .shape-color + .shape-color { margin-left: 8px; }
  .shape-color-entry { display: flex; align-items: center; }
  .shape-color-entry input { flex: 1; min-width: 70px; width: 100%; }
  .shape-swatch { width: 17px; height: 17px; border: 1px solid #9f9cac; border-radius: 4px; margin-right: 6px; }
  .shape-line-color { margin-top: 7px; }
  .shape-footer { border-top: 1px solid #353542; padding-top: 14px; padding-bottom: 14px; }
  .shape-status { color: #ffbbae; margin: 0 14px 0 0; font-size: 12px; max-width: 56%; }
  .shape-actions { display: flex; margin-left: auto; }
  .shape-actions button { min-height: 37px; }
  .shape-studio .shape-generate {
    margin-left: 8px; padding: 0 16px; border-color: #c2b5ff; background: #c2b5ff; color: #1e1833;
  }
  .shape-studio .shape-generate:hover { background: #ddd4ff; }
  @media (max-width: 685px) {
    .shape-left { flex-basis: 100%; min-width: 0; margin-right: 0; margin-bottom: 18px; }
    .shape-controls { flex-basis: 100%; min-width: 0; }
    .shape-preview { height: 210px; }
    .shape-preview-message { top: 91px; }
  }
  @media (max-width: 400px) {
    .shape-header, .shape-footer { flex-wrap: wrap; }
    .shape-output { margin-top: 8px; }
    .shape-status { max-width: 100%; }
  }
`;

function rangeField(id, title, min, max, initial, suffix = "") {
  return `<div class="shape-range">
    <div class="shape-inline">
      <label for="${id}">${title}</label>
      <span class="shape-value" id="${id}-value">${initial}${suffix}</span>
    </div>
    <input type="range" id="${id}" min="${min}" max="${max}" value="${initial}">
  </div>`;
}

function colorField(id, title, initial) {
  return `<div class="shape-color" id="${id}-field">
    <label for="${id}" id="${id}-label">${title}</label>
    <div class="shape-color-entry">
      <span class="shape-swatch" id="${id}-swatch" style="background:${initial}"></span>
      <input type="text" id="${id}" value="${initial}" maxlength="7">
    </div>
  </div>`;
}

async function askSettings(doc) {
  const dialog = document.createElement("dialog");
  const stylesheet = document.createElement("style");
  stylesheet.textContent = studioStyles;
  dialog.className = "shape-studio";
  dialog.setAttribute("aria-labelledby", "shape-title");
  dialog.innerHTML = `
    <header class="shape-header">
      <h1 class="shape-title" id="shape-title">Shape Studio</h1>
      <div class="shape-output">
        <span class="shape-caption">Output</span>
        <div class="shape-segments" role="group" aria-label="Output">
          <button id="vector" type="button" class="selected" aria-pressed="true">Vector</button>
          <button id="raster" type="button" aria-pressed="false">Raster</button>
        </div>
      </div>
    </header>
    <div class="shape-body">
      <section class="shape-left">
        <div class="shape-inline shape-preview-header">
          <h2 class="shape-eyebrow">PREVIEW</h2>
          <button id="random" type="button">Randomize blob</button>
        </div>
        <div class="shape-preview">
          <img id="preview" width="${previewWidth}" height="${previewHeight}" alt="Shape preview" style="display:none">
          <span id="preview-message" class="shape-preview-message">Rendering preview…</span>
        </div>
        <div id="seed-row" class="shape-inline shape-seed">
          <label for="seed">Blob seed</label>
          <input type="text" id="seed" value="38" maxlength="6">
        </div>
      </section>
      <div class="shape-controls">
        <section class="shape-section">
          <h2 class="shape-eyebrow">SHAPE</h2>
          <label for="shape">Preset</label>
          <select id="shape">${shapes.map((name, i) => `<option value="${i}">${name}</option>`).join("")}</select>
          ${rangeField("size", "Size", 2, 96, 60, "%")}
        </section>
        <section class="shape-section">
          <h2 class="shape-eyebrow">FILL</h2>
          <div class="shape-segments" role="group" aria-label="Fill type">
            <button id="solid" type="button" class="selected" aria-pressed="true">Solid</button>
            <button id="gradient" type="button" aria-pressed="false">Gradient</button>
          </div>
          <div class="shape-colors">
            ${colorField("first", "Fill color", "#5128C8")}
            ${colorField("second", "End color", "#FF9C57")}
          </div>
          <div id="angle-row">${rangeField("angle", "Angle", -180, 180, 45, "°")}</div>
        </section>
        <section class="shape-section">
          <h2 class="shape-eyebrow">CONTOURS</h2>
          ${rangeField("count", "Topo lines", 0, 18, 7)}
          <div class="shape-line-color">${colorField("line", "Line color", "#FFF3E5")}</div>
        </section>
      </div>
    </div>
    <footer class="shape-footer">
      <p id="status" class="shape-status" role="status" aria-live="polite"></p>
      <div class="shape-actions">
        <button id="cancel" type="button">Cancel</button>
        <button id="generate" class="shape-generate" type="button">Generate shape</button>
      </div>
    </footer>`;
  document.head.appendChild(stylesheet);
  document.body.appendChild(dialog);

  const get = id => dialog.querySelector("#" + id);
  const numericValue = id => Number(get(id).value);
  const colorValue = id => String(get(id).value).trim().replace(/^#/, "");
  const isHex = value => /^[0-9a-f]{6}$/i.test(value);
  const visible = (id, show, layout = "block") => { get(id).style.display = show ? layout : "none"; };
  const toggle = (id, active) => {
    const button = get(id);
    button.className = active ? "selected" : "";
    button.setAttribute("aria-pressed", String(active));
  };

  let fill = 0, output = 0;
  let settings = null;
  let redraw, revision = 0;

  function readSettings() {
    const shape = numericValue("shape"), count = numericValue("count");
    const seedText = String(get("seed").value).trim();
    if (shape === 0 && !/^\d{1,6}$/.test(seedText)) throw new Error("Enter a blob seed from 0 to 999999.");
    const first = colorValue("first"), second = colorValue("second"), line = colorValue("line");
    if (!isHex(first)) throw new Error("Enter a six-digit hex value for the fill color.");
    if (fill && !isHex(second)) throw new Error("Enter a six-digit hex value for the gradient end color.");
    if (count && !isHex(line)) throw new Error("Enter a six-digit hex value for the line color.");
    return { shape, count, fill, output, seed: shape === 0 ? Number(seedText) : 0,
      size: numericValue("size"), angle: fill ? numericValue("angle") : 0, first, second, line };
  }

  function refresh() {
    toggle("solid", fill === 0);
    toggle("gradient", fill === 1);
    toggle("vector", output === 0);
    toggle("raster", output === 1);
    visible("seed-row", numericValue("shape") === 0, "flex");
    visible("second-field", fill === 1);
    visible("angle-row", fill === 1);
    visible("line-field", numericValue("count") > 0);
    get("first-label").textContent = fill ? "Start color" : "Fill color";
    get("size-value").textContent = numericValue("size") + "%";
    get("count-value").textContent = String(numericValue("count"));
    get("angle-value").textContent = numericValue("angle") + "°";
    for (const id of ["first", "second", "line"]) {
      const value = colorValue(id);
      if (isHex(value)) get(id + "-swatch").style.backgroundColor = "#" + value;
    }

    clearTimeout(redraw);
    const render = ++revision;
    let draft;
    try {
      draft = readSettings();
      get("status").textContent = "";
    } catch (error) {
      get("status").textContent = error.message;
      return;
    }

    redraw = setTimeout(async () => {
      try {
        const src = await previewImage(doc, draft);
        if (render !== revision) return;
        get("preview").src = src;
        visible("preview", true);
        visible("preview-message", false);
      } catch (error) {
        if (render !== revision) return;
        visible("preview", false);
        get("preview-message").textContent = "Preview unavailable";
        visible("preview-message", true);
      }
    }, 55);
  }

  get("random").addEventListener("click", () => {
    get("shape").value = "0";
    get("seed").value = String(1 + Math.floor(Math.random() * 999999));
    refresh();
  });
  ["solid", "gradient"].forEach((id, i) => get(id).addEventListener("click", () => {
    fill = i;
    refresh();
  }));
  ["vector", "raster"].forEach((id, i) => get(id).addEventListener("click", () => {
    output = i;
    toggle("vector", output === 0);
    toggle("raster", output === 1);
  }));
  for (const id of ["seed", "size", "angle", "count", "first", "second", "line"]) {
    get(id).addEventListener("input", refresh);
    get(id).addEventListener("change", refresh);
  }
  get("shape").addEventListener("change", refresh);
  get("cancel").addEventListener("click", () => dialog.close());
  get("generate").addEventListener("click", () => {
    try {
      settings = readSettings();
      dialog.close();
    } catch (error) {
      get("status").textContent = error.message;
    }
  });

  try {
    refresh();
    await dialog.showModal();
    return settings;
  } finally {
    revision++;
    clearTimeout(redraw);
    document.body.removeChild(dialog);
    document.head.removeChild(stylesheet);
  }
}

try {
  if (!app.documents.length) throw new Error("Open an RGB document, then run Shape Studio.");
  const doc = app.activeDocument;
  if (doc.mode !== constants.DocumentMode.RGB || doc.artboards.length) {
    throw new Error("This build uses an RGB document with a single canvas.");
  }
  const settings = await askSettings(doc);
  if (settings) await generate(doc, settings);
} catch (error) {
  await app.showAlert("Shape Studio\n" + (error.message || error));
}
